PORT=4000
MONGODB_URI=mongodb://localhost:27017/whatsapp-crm-ci
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:5173

# GeniusPay (https://pay.genius.ci/doc)
GENIUSPAY_API_KEY=pk_sandbox_xxx
GENIUSPAY_API_SECRET=sk_sandbox_xxx
GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1
GENIUSPAY_WEBHOOK_SECRET=sk_sandbox_xxx
GENIUSPAY_ENVIRONMENT=sandbox

# Public URL of this API, used to build GeniusPay webhook/redirect URLs
APP_BASE_URL=http://localhost:4000
FRONTEND_BASE_URL=http://localhost:5173

# S3-compatible storage for product photo uploads (routes/uploads.js)
S3_REGION=eu-west-3
S3_ENDPOINT=
S3_BUCKET=relance-uploads
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx
S3_PUBLIC_BASE_URL=https://relance-uploads.s3.eu-west-3.amazonaws.com

# Resend (weekly digest email — jobs/weeklyDigestJob.js). Optional: without
# it the job just skips emailing and the in-app digest still works.
RESEND_API_KEY=
DIGEST_FROM_EMAIL=digest@relance.ci
